# Lokalne sekrety i poświadczenia integracji — nie dodawaj ich do repozytorium.
.env
.env.*
!.env.example
!.env.sample

# Klucze prywatne, certyfikaty i lokalne pliki poświadczeń.
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Lokalne dane oraz kopie zapasowe n8n.
n8n_data/
.n8n/
*.sqlite
*.sqlite-journal

# Materiały przeniesione do prywatnego STFS-Templates; pozostają lokalnie
# tylko jako kopie robocze i nigdy nie są publikowane na stfs.pl.
.site-stage-*/
dist/
menu/
kontakt/
przyjecia/
refinement.css
