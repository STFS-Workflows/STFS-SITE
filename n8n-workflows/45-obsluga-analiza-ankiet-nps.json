    {
      "name": "AI: prompt (komentarz detraktora)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Analizujesz komentarz niezadowolonego klienta z ankiety NPS. Streść problem jednym zdaniem i nazwij główny temat. Jeśli komentarza brak – napisz, że klient nie podał powodu.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"temat\\\": np. obsługa, cena, jakość, termin, inne, \\\"streszczenie\\\": 1 zdanie}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Ocena: ${$json.score}/10\\nKomentarz: ${$json.comment || '(brak)'}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 600,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        1900,
        300
      ],
      "id": "2e1ed900-fda5-415c-a3d5-76c4db704120"
    },
