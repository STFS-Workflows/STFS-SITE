    {
      "name": "Policz grupę NPS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const score = Number($json.score);\nif (!Number.isInteger(score) || score < 0 || score > 10) throw new Error('Ocena musi być liczbą 0-10');\nconst grupa = score <= 6 ? 'detraktor' : score <= 8 ? 'pasywny' : 'promotor';\nreturn { json: { ...$json, score, grupa, comment: String($json.comment || '').slice(0, 2000) } };"
      },
      "position": [
        860,
        300
