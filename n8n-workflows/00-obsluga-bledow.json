    {
      "name": "Przygotuj alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $('Błąd w workflow').item.json;\nconst wfName = e.workflow?.name || 'nieznany workflow';\nconst nodeName = e.execution?.lastNodeExecuted || '?';\nconst msg = (e.execution?.error?.message || 'brak komunikatu').slice(0, 500);\nconst url = e.execution?.url || '';\nreturn { json: { tekst: '❌ Błąd: ' + wfName + '\\nWęzeł: ' + nodeName + '\\nKomunikat: ' + msg + (url ? '\\n' + url : '') , temat: 'Błąd n8n: ' + wfName } };"
      },
      "position": [
        600,
        300
      ],
      "id": "a7abc334-f1c0-4e8c-a0dd-189b932cf857"
    },
