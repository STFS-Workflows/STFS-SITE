    {
      "name": "Oceń odpowiedź",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const url = $('Lista adresów').item.json.url;\nconst kod = Number($json.statusCode || 0);\nconst ok = !$json.error && kod >= 200 && kod < 400;\nconst blad = $json.error ? String($json.error.message || $json.error).slice(0, 200) : (ok ? '' : 'HTTP ' + kod);\nreturn { json: { url, ok, kod, blad } };"
      },
