    {
      "name": "Porównaj z własną ceną",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const own = Number($json.ownPrice);\nconst comp = Number($json.competitorPrice);\nconst ok = Number.isFinite(own) && Number.isFinite(comp) && comp > 0;\nconst diffPct = ok ? Math.round(((own - comp) / comp) * 1000) / 10 : 0;\nreturn { json: { ...$json, diffPct, diffAbs: Math.abs(diffPct) } };"
      },
