    {
      "name": "Zbierz raport cenowy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const lines = $input.all().map((i) => '• ' + i.json.productName + ': Ty ' + i.json.ownPrice + ' zł vs ' + (i.json.competitor || 'konkurencja') + ' ' + i.json.competitorPrice + ' zł (' + (i.json.diffPct > 0 ? '+' : '') + i.json.diffPct + '%)');\nreturn [{ json: { liczba: lines.length, lista: lines.join('\\n') } }];"
      },
      "position": [
