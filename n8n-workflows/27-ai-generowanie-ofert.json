        "jsonBody": "={{ JSON.stringify({ template: \"oferta\", data: { klient: $json.name, tytul: $json.tytul, pozycje: $json.pozycje, sumaNetto: $json.sumaNetto, uwagi: $json.uwagi } }) }}",
        "options": {
