    },
    {
      "name": "Maks. 1 alert dziennie na metrykę",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"anomalie\"] = store[\"anomalie\"] || {};\nconst seen = store[\"anomalie\"];\nconst now = Date.now();\nconst ttl = 3 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.kluczDnia ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1640,
        300
      ],
      "id": "6ad25999-e4de-4b97-ab54-10cf8501c864"
    },
