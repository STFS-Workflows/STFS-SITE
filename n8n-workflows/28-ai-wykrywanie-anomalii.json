      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"anomalie\"] = store[\"anomalie\"] || {};\nconst src = $('Maks. 1 alert dziennie na metrykę').item.json;\nconst key = String(src.kluczDnia ?? '');\nif (key) store[\"anomalie\"][key] = Date.now();\nreturn { json: $json };"
      },
