    {
      "name": "Oblicz odchylenie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cur = Number($json.current);\nconst avg = Number($json.average);\nconst ok = Number.isFinite(cur) && Number.isFinite(avg) && avg !== 0;\nconst deviation = ok ? Math.round(Math.abs((cur - avg) / avg) * 1000) / 10 : 0;\nreturn { json: { ...$json, deviation, kierunek: cur > avg ? 'wzrost' : 'spadek', kluczDnia: $json.metricName + '-' + $now.toISODate() } };"
      },
      "position": [
        1120,
        300
      ],
      "id": "4a11ae5e-a5d2-49ff-a248-424c50b162f8"
    },
    {
      "name": "Odchylenie ponad próg?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "0aa7feee-94ec-4135-af07-ea99931fa0a8",
              "leftValue": "={{ $json.deviation }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": "={{ $('Konfiguracja').first().json.progOdchylenia }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
