    {
      "name": "Pomiń już przypomniane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"wizyty\"] = store[\"wizyty\"] || {};\nconst seen = store[\"wizyty\"];\nconst now = Date.now();\nconst ttl = 14 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.id ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1120,
        300
      ],
      "id": "b9dffc4a-6516-4866-a632-dce16dde5993"
    },
    {
      "name": "Przygotuj treść",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $('Konfiguracja').first().json;\nconst start = new Date($json.start);\nconst godzina = start.toLocaleTimeString('pl-PL', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' });\nconst tresc = c.nazwaFirmy + ': przypominamy o wizycie jutro o ' + godzina + (($json.service) ? ' (' + $json.service + ')' : '') + ', ' + c.adres + '.' + ($json.cancelUrl ? ' Zmiana/odwołanie: ' + $json.cancelUrl : '');\nreturn { json: { ...$json, godzina, tresc } };"
      },
      "position": [
        1380,
        300
      ],
      "id": "6117244a-4b37-490e-a2dc-7cfb4173d02b"
    },
