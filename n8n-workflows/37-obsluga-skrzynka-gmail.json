    {
      "name": "Przygotuj wiadomość",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const from = $json.from?.value?.[0] || {};\nconst adres = String(from.address || '').toLowerCase();\nconst pomijaj = $('Konfiguracja').first().json.pomijaj.split(',').map((s) => s.trim()).filter(Boolean);\nconst naglowki = $json.headers || {};\nconst automatyczna = pomijaj.some((p) => adres.includes(p)) || Boolean(naglowki['list-unsubscribe']);\nreturn { json: { id: $json.id, threadId: $json.threadId, od: adres, odNazwa: from.name || '',\n  temat: $json.subject || '(bez tematu)', tresc: String($json.text || '').slice(0, 6000), automatyczna } };"
      },
      "position": [
        600,
        300
      ],
      "id": "b604d0f8-9779-4c3a-a63c-e3ffde18b8e9"
    },
    {
      "name": "Do obsłużenia?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
