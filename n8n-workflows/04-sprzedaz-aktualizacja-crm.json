              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "f7efbe3b-f717-46f9-a2df-8ff6912e72a8",
              "name": "source",
              "value": "={{ $json.source || \"strona\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "62210761-bf1b-43ee-a51e-b2a5f7690cd5",
      "name": "Zapisz/Aktualizuj w CRM",
