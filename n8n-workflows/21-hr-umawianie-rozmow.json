    {
      "name": "Policz koniec rozmowy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const start = new Date($json.start);\nif (isNaN(start) || start < new Date()) throw new Error('Niepoprawny lub przeszły termin');\nconst end = new Date(start.getTime() + $('Konfiguracja').first().json.czasTrwaniaMin * 60000);\nreturn { json: { ...$json, startISO: start.toISOString(), endISO: end.toISOString(),\n  terminTekst: start.toLocaleString('pl-PL', { timeZone: 'Europe/Warsaw', dateStyle: 'full', timeStyle: 'short' }) } };"
      },
      "position": [
        860,
        300
      ],
      "id": "09541a49-8964-4687-a320-3fb2a005bbad"
    },
