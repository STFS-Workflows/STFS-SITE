    {
      "name": "Pomiń już przypomniane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"koszyki\"] = store[\"koszyki\"] || {};\nconst seen = store[\"koszyki\"];\nconst now = Date.now();\nconst ttl = 30 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.cartId ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1380,
        300
      ],
      "id": "c394c252-f2c4-495b-a590-2de6b7bd40ab"
    },
    {
      "name": "AI: prompt (przypomnienie)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Piszesz krótkie (2-3 zdania), przyjazne przypomnienie o pozostawionym koszyku. Po polsku, bez presji, bez wymyślania rabatów.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"temat\\\": krótki temat, \\\"tresc\\\": treść bez linku}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Sklep: ${$('Konfiguracja').first().json.nazwaSklepu}\\nImię: ${$json.firstName || ''}\\nProdukty: ${(($json.items || []).map((i) => i.name || i.title)).join(', ')}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 600,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        1640,
        300
      ],
      "id": "9dae55e2-4135-4132-aff7-ca5578bfba8d"
    },
    {
      "name": "AI: przypomnienie",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._aiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Credential Header Auth: Authorization = Bearer <klucz OpenAI>. Można podmienić na Claude/inny model.",
      "notesInFlow": true,
