    {
      "name": "Przygotuj plik",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $('Konfiguracja').first().json;\nconst wf = { ...$json };\ndelete wf.staticData; delete wf.pinData; delete wf.shared;\nconst slug = String(wf.name || 'bez-nazwy').replace(/ł/g, 'l').replace(/Ł/g, 'L').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);\nconst sciezka = c.katalog + '/' + slug + '-' + wf.id + '.json';\nconst zawartosc = Buffer.from(JSON.stringify(wf, null, 2) + '\\n', 'utf8').toString('base64');\nreturn { json: { sciezka, nazwa: wf.name, id: wf.id, zawartosc } };"
      },
