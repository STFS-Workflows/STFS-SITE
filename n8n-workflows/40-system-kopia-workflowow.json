    {
      "name": "Porównaj z repo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const plik = $('Przygotuj plik').item.json;\nconst istnieje = $json.statusCode === 200 && $json.body && $json.body.sha;\nconst stara = istnieje ? String($json.body.content || '').replace(/\\n/g, '') : '';\nreturn { json: { ...plik, sha: istnieje ? $json.body.sha : null, zmieniony: stara !== plik.zawartosc } };"
      },
