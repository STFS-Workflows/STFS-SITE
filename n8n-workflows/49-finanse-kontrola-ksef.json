    {
      "name": "Oceń status KSeF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const h = $('Konfiguracja').first().json.godzinDoAlarmu;\nconst godzin = (Date.now() - Date.parse($json.issuedAt)) / 3600000;\nconst status = String($json.ksefStatus || '').toLowerCase();\nconst problem = status === 'rejected' || (status !== 'accepted' && godzin > h);\nreturn { json: { ...$json, status, godzin: Math.round(godzin), problem, klucz: $json.id + '-' + status } };"
      },
      "position": [
        1120,
        300
      ],
      "id": "c90e886f-56cc-41fb-acd2-bd460d1c325e"
    },
