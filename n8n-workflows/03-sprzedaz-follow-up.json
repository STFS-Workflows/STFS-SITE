    {
      "name": "Policz dni od kontaktu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const last = Date.parse($json.lastContactAt);\nconst dni = Number.isFinite(last) ? Math.floor((Date.now() - last) / 86400000) : null;\nreturn { json: { ...$json, dniOdKontaktu: dni } };"
      },
