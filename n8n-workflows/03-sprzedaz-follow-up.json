        "jsCode": "const SYSTEM = \"Piszesz krótki (2-3 zdania), nienachalny follow-up do potencjalnego klienta, który nie odpowiedział. Po polsku, uprzejmie, jedno pytanie na końcu. Bez emoji i bez presji.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"temat\\\": krótki temat, \\\"tresc\\\": treść wiadomości}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Imię: ${$json.name}\\nDni od ostatniego kontaktu: ${$json.dniOdKontaktu}\\nKontekst: ${$json.notes || '-'}`;\nreturn {\n  json: {\n    ...$json,\n    _aiPrompt: String(user).slice(0, 12000),\n  },\n};"
      },
