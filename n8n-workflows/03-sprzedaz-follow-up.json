    {
      "name": "Pomiń już obsłużone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"followup\"] = store[\"followup\"] || {};\nconst seen = store[\"followup\"];\nconst now = Date.now();\nconst ttl = 90 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.id ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1640,
        300
      ],
      "id": "1b5f9915-f9fb-4184-a92c-7075ef6a3d0c"
    },
    {
      "name": "AI: prompt (follow-up)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Piszesz krótki (2-3 zdania), nienachalny follow-up do potencjalnego klienta, który nie odpowiedział. Po polsku, uprzejmie, jedno pytanie na końcu. Bez emoji i bez presji.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"temat\\\": krótki temat, \\\"tresc\\\": treść wiadomości}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Imię: ${$json.name}\\nDni od ostatniego kontaktu: ${$json.dniOdKontaktu}\\nKontekst: ${$json.notes || '-'}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 600,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        1900,
        300
      ],
      "id": "3d6dd065-560d-4299-ad59-a9e8e1a477cf"
    },
    {
      "name": "AI: follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._aiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Credential Header Auth: Authorization = Bearer <klucz OpenAI>. Można podmienić na Claude/inny model.",
      "notesInFlow": true,
      "position": [
        2160,
        300
      ],
      "id": "b2003090-e2c8-443d-a664-0866273a3fbc"
    },
    {
      "name": "AI: wynik (follow-up)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Łączymy dane wejściowe (sprzed wywołania AI) z odpowiedzią modelu.\nconst ctx = { ...$('AI: prompt (follow-up)').item.json };\ndelete ctx._aiRequest;\nlet out = {};\nlet aiError = '';\ntry {\n  const raw = $json.choices?.[0]?.message?.content ?? '';\n  out = JSON.parse(raw);\n  if (!out || typeof out !== 'object' || Array.isArray(out)) throw new Error('to nie obiekt');\n} catch (e) {\n  aiError = 'Nie udało się odczytać odpowiedzi AI: ' + e.message;\n  out = {};\n}\nconst defaults = {\"temat\":\"\",\"tresc\":\"\"};\nfor (const [k, v] of Object.entries(defaults)) if (out[k] === undefined || out[k] === null) out[k] = v;\nfor (const [k, v] of Object.entries(out)) if (typeof v === 'string') out[k] = v.slice(0, 4000);\n\nreturn { json: { ...ctx, ...out, _aiOk: !aiError, _aiError: aiError } };"
      },
      "position": [
        2420,
        300
      ],
      "id": "07f0b03b-891f-45ce-ad78-dc2f8b009b92"
    },
