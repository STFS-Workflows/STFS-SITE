    {
      "name": "Wybierz posty do publikacji",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const teraz = Date.now();\nreturn $input.all().map((i, n) => ({ i, n })).filter(({ i }) => {\n  const r = i.json;\n  const t = Date.parse(r.data);\n  return String(r.status).trim().toLowerCase() === 'zatwierdzony' && String(r.kanal).trim().toLowerCase() === 'facebook'\n    && Number.isFinite(t) && t <= teraz && String(r.tresc || '').trim() && !r.postId;\n}).map(({ i, n }) => ({ json: i.json, pairedItem: { item: n } }));"
      },
      "position": [
        860,
        300
      ],
      "id": "17e3750c-c16c-48e3-a9ee-b713c8e56f2c"
    },
    {
      "name": "Pomiń już opublikowane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"posty\"] = store[\"posty\"] || {};\nconst seen = store[\"posty\"];\nconst now = Date.now();\nconst ttl = 365 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.id ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1120,
        300
      ],
      "id": "a02c7f07-e21f-4d7e-a608-b79ef25aa8eb"
    },
