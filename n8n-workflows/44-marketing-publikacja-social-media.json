    {
      "name": "Zapamiętaj publikację",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"posty\"] = store[\"posty\"] || {};\nconst src = $('Pomiń już opublikowane').item.json;\nconst key = String(src.id ?? '');\nif (key) store[\"posty\"][key] = Date.now();\nreturn { json: $json };"
      },
