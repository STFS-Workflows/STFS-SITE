    {
      "name": "Pomiń już widziane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"wzmianki\"] = store[\"wzmianki\"] || {};\nconst seen = store[\"wzmianki\"];\nconst now = Date.now();\nconst ttl = 30 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.id ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1120,
        300
      ],
      "id": "4b622f65-774e-4362-a77b-4771b199ea9e"
    },
    {
      "name": "AI: prompt (sentyment)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Klasyfikujesz wzmiankę o marce w internecie.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"sentyment\\\": \\\"pozytywna\\\" | \\\"neutralna\\\" | \\\"negatywna\\\", \\\"powod\\\": krótkie uzasadnienie}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Źródło: ${$json.source || '-'}\\nTreść: ${$json.text}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 600,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        1380,
        300
      ],
      "id": "a751bb88-41dd-413a-a37b-0efe0100d6f7"
    },
    {
      "name": "AI: sentyment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._aiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Credential Header Auth: Authorization = Bearer <klucz OpenAI>. Można podmienić na Claude/inny model.",
      "notesInFlow": true,
      "position": [
        1640,
        300
      ],
      "id": "afff10a9-9011-48ed-a1dc-753bf9ec02a2"
    },
    {
      "name": "AI: wynik (sentyment)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Łączymy dane wejściowe (sprzed wywołania AI) z odpowiedzią modelu.\nconst ctx = { ...$('AI: prompt (sentyment)').item.json };\ndelete ctx._aiRequest;\nlet out = {};\nlet aiError = '';\ntry {\n  const raw = $json.choices?.[0]?.message?.content ?? '';\n  out = JSON.parse(raw);\n  if (!out || typeof out !== 'object' || Array.isArray(out)) throw new Error('to nie obiekt');\n} catch (e) {\n  aiError = 'Nie udało się odczytać odpowiedzi AI: ' + e.message;\n  out = {};\n}\nconst defaults = {\"sentyment\":\"\",\"powod\":\"\"};\nfor (const [k, v] of Object.entries(defaults)) if (out[k] === undefined || out[k] === null) out[k] = v;\nfor (const [k, v] of Object.entries(out)) if (typeof v === 'string') out[k] = v.slice(0, 4000);\n\nreturn { json: { ...ctx, ...out, _aiOk: !aiError, _aiError: aiError } };"
      },
      "position": [
        1900,
        300
      ],
      "id": "ed3d52be-e97a-42d7-a59c-9bf8d170b481"
    },
    {
      "name": "Zapamiętaj wzmiankę",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"wzmianki\"] = store[\"wzmianki\"] || {};\nconst src = $json;\nconst key = String(src.id ?? '');\nif (key) store[\"wzmianki\"][key] = Date.now();\nreturn { json: $json };"
      },
