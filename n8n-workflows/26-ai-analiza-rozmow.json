    {
      "name": "AI: prompt (ocena rozmowy)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Jesteś trenerem sprzedaży. Oceniasz transkrypcję rozmowy sprzedażowej: otwarcie, badanie potrzeb, prezentacja, obsługa obiekcji, ustalenie następnego kroku.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"ocena\\\": liczba 1-10, \\\"mocneStrony\\\": tablica, \\\"doPoprawy\\\": tablica, \\\"nastepnyKrok\\\": tekst lub null}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Transkrypcja:\\n${$json.text}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 800,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        1380,
        300
      ],
      "id": "ccfc4d11-bda0-4348-af02-87ac9bf91643"
    },
    {
      "name": "AI: ocena rozmowy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._aiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Credential Header Auth: Authorization = Bearer <klucz OpenAI>. Można podmienić na Claude/inny model.",
      "notesInFlow": true,
      "position": [
