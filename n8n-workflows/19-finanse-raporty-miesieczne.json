    {
      "name": "AI: prompt (podsumowanie miesiąca)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Jesteś analitykiem finansowym małej firmy. Na podstawie danych (JSON) napisz zwięzłe podsumowanie miesiąca po polsku. Używaj tylko liczb z danych.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"podsumowanie\\\": 3-5 zdań, \\\"najwazniejsze\\\": tablica maks. 5 punktów z liczbami, \\\"ryzyka\\\": tablica maks. 3 punktów}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Dane za poprzedni miesiąc:\\n${JSON.stringify($json).slice(0, 8000)}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 900,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        860,
        300
      ],
      "id": "7aad162b-d858-42c9-a790-f894a9ad0345"
    },
    {
      "name": "AI: podsumowanie miesiąca",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._aiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Credential Header Auth: Authorization = Bearer <klucz OpenAI>. Można podmienić na Claude/inny model.",
      "notesInFlow": true,
      "position": [
        1120,
        300
      ],
      "id": "4d56a070-ed56-4b52-a92c-3899af1c8975"
    },
    {
      "name": "AI: wynik (podsumowanie miesiąca)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Łączymy dane wejściowe (sprzed wywołania AI) z odpowiedzią modelu.\nconst ctx = { ...{} };\ndelete ctx._aiRequest;\nlet out = {};\nlet aiError = '';\ntry {\n  const raw = $json.choices?.[0]?.message?.content ?? '';\n  out = JSON.parse(raw);\n  if (!out || typeof out !== 'object' || Array.isArray(out)) throw new Error('to nie obiekt');\n} catch (e) {\n  aiError = 'Nie udało się odczytać odpowiedzi AI: ' + e.message;\n  out = {};\n}\nconst defaults = {\"podsumowanie\":\"\",\"najwazniejsze\":\"\",\"ryzyka\":\"\"};\nfor (const [k, v] of Object.entries(defaults)) if (out[k] === undefined || out[k] === null) out[k] = v;\nfor (const [k, v] of Object.entries(out)) if (typeof v === 'string') out[k] = v.slice(0, 4000);\n\nreturn { json: { ...ctx, ...out, _aiOk: !aiError, _aiError: aiError } };"
      },
      "position": [
        1380,
        300
      ],
      "id": "4afef731-6040-484c-ae60-952556846905"
    },
