        "mode": "runOnceForEachItem",
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"transakcje\"] = store[\"transakcje\"] || {};\nconst src = $json;\nconst key = String(src.id ?? '');\nif (key) store[\"transakcje\"][key] = Date.now();\nreturn { json: $json };"
      },
