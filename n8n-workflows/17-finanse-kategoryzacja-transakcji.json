    {
      "name": "Pomiń już skategoryzowane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore[\"transakcje\"] = store[\"transakcje\"] || {};\nconst seen = store[\"transakcje\"];\nconst now = Date.now();\nconst ttl = 400 * 86400000;\nfor (const [k, t] of Object.entries(seen)) if (now - t > ttl) delete seen[k];\nconst out = [];\n$input.all().forEach((item, index) => {\n  const key = String(item.json.id ?? '');\n  if (!key || seen[key]) return; // brak klucza albo już obsłużone -> pomiń\n  // pairedItem zachowuje powiązanie z danymi wejściowymi (potrzebne dla odwołań .item w kolejnych węzłach)\n  out.push({ json: item.json, binary: item.binary, pairedItem: { item: index } });\n});\nreturn out;"
      },
      "position": [
        1120,
        300
      ],
      "id": "321571af-b311-4acf-a310-27bd5d2dbda8"
    },
    {
      "name": "AI: prompt (kategoria kosztu)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SYSTEM = \"Przypisujesz transakcję bankową do jednej kategorii kosztowej z podanej listy.\\n\\nOdpowiedz WYŁĄCZNIE poprawnym obiektem JSON z polami: {\\\"kategoria\\\": jedna z listy, \\\"pewnosc\\\": liczba 0-1}. Nie wymyślaj faktów, cen ani danych, których nie ma w treści.\";\nconst user = `Kategorie: ${$('Konfiguracja').first().json.kategorie}\\nKontrahent: ${$json.counterparty}\\nTytuł: ${$json.title}\\nKwota: ${$json.amount}`;\nreturn {\n  json: {\n    ...$json,\n    _aiRequest: {\n      model: ($('Konfiguracja').first().json.modelAI || \"gpt-4o-mini\"),\n      max_tokens: 600,\n      temperature: 0.3,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM },\n        { role: 'user', content: String(user).slice(0, 12000) },\n      ],\n    },\n  },\n};"
      },
      "position": [
        1380,
        300
      ],
      "id": "31b8ac5f-a600-47e0-ac8a-0a2c8f1999ce"
    },
    {
      "name": "AI: kategoria kosztu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._aiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Credential Header Auth: Authorization = Bearer <klucz OpenAI>. Można podmienić na Claude/inny model.",
      "notesInFlow": true,
      "position": [
        1640,
        300
      ],
      "id": "ed7cd370-e210-4ef7-ac6f-dd14175365eb"
    },
    {
      "name": "AI: wynik (kategoria kosztu)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Łączymy dane wejściowe (sprzed wywołania AI) z odpowiedzią modelu.\nconst ctx = { ...$('AI: prompt (kategoria kosztu)').item.json };\ndelete ctx._aiRequest;\nlet out = {};\nlet aiError = '';\ntry {\n  const raw = $json.choices?.[0]?.message?.content ?? '';\n  out = JSON.parse(raw);\n  if (!out || typeof out !== 'object' || Array.isArray(out)) throw new Error('to nie obiekt');\n} catch (e) {\n  aiError = 'Nie udało się odczytać odpowiedzi AI: ' + e.message;\n  out = {};\n}\nconst defaults = {\"kategoria\":\"\",\"pewnosc\":0};\nfor (const [k, v] of Object.entries(defaults)) if (out[k] === undefined || out[k] === null) out[k] = v;\nfor (const [k, v] of Object.entries(out)) if (typeof v === 'string') out[k] = v.slice(0, 4000);\nout.pewnosc = Math.max(0, Math.min(1, Number(out.pewnosc)));\nif (!Number.isFinite(out.pewnosc)) out.pewnosc = 0;\nreturn { json: { ...ctx, ...out, _aiOk: !aiError, _aiError: aiError } };"
      },
      "position": [
        1900,
        300
      ],
      "id": "63f0e1c5-b6e4-4c52-aa83-e875d0563bc0"
    },
